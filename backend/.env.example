PORT=5000

# =========================================================
# PostgreSQL / Supabase
# =========================================================

PG_HOST=your_supabase_host.pooler.supabase.com
PG_USER=postgres.your_project_id
PG_PASSWORD=your_database_password_here
PG_DATABASE=postgres
PG_PORT=6543

DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# =========================================================
# Authentication
# =========================================================

JWT_SECRET=replace_with_a_long_random_secret

# =========================================================
# Frontend
# =========================================================

FRONTEND_URL=http://localhost:3000

# =========================================================
# Google Calendar OAuth
# =========================================================

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth2callback

# =========================================================
# Patient Email Notifications - Gmail SMTP
# =========================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=medicareaicenter@gmail.com
SMTP_PASS=your_gmail_app_password_here

MAIL_FROM=Medicare AI Center <medicareaicenter@gmail.com>

# Optional legacy aliases if older backend code still uses them
EMAIL_USER=medicareaicenter@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# =========================================================
# n8n
# =========================================================

# For LOCAL n8n testing:
N8N_ASSISTANT_WEBHOOK=http://localhost:5678/webhook/medicare-assistant-clean

# Only needed if you deploy n8n separately
N8N_HOST=your-n8n-host.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-n8n-host.example.com/
N8N_EDITOR_BASE_URL=https://your-n8n-host.example.com/
N8N_PROXY_HOPS=1

# =========================================================
# Cloudinary
# =========================================================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_preset_name
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# =========================================================
# Appointment Reminder Scheduler
# =========================================================
REMINDER_JOB_SECRET=replace_with_a_long_random_secret

# =========================================================
# Human handover / reception
# =========================================================
MEDICARE_PHONE=your_medicare_phone_number_here


# =========================================================
# ElevenLabs API Key
# =========================================================
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY